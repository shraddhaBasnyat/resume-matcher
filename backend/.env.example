# Server
PORT=3001

# LLM
USE_CLOUD_LLM=false
ANTHROPIC_API_KEY=

# Supabase — SUPABASE_URL also drives the JWKS endpoint for JWT verification
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
SUPABASE_CA_CERT=           # base64-encoded Supabase CA cert for Postgres SSL; omit for local dev (falls back to rejectUnauthorized: false)

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=resume-matcher
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# CORS — required in production, set to your Vercel frontend URL
# FRONTEND_URL=https://your-app.vercel.app